# Copy to server/.env on the host (never committed). No inline comments: compose keeps them as part of the value.
# TOKEN_SECRET: openssl rand -hex 32
TOKEN_SECRET=
# OPENROUTER_API_KEY: a NEW key with credit, used only by this server
OPENROUTER_API_KEY=
# FREE_FACULTY: 1 during the pilot (faculty without a purchase), 0 at launch
FREE_FACULTY=1
# IAP_DEV_SECRET: lets the app mint a test entitlement (platform 'dev'); blank in production
IAP_DEV_SECRET=
# Apple purchases arrive as StoreKit 2 transactions (JWS) and are checked against Apple's root certificate; nothing to configure
# APPLE_BUNDLE_ID: must equal the app's bundle id
APPLE_BUNDLE_ID=com.lyceum.app
# APPLE_SHARED_SECRET: only for legacy app receipts (App Store Connect → App Information → App-Specific Shared Secret)
APPLE_SHARED_SECRET=
# GOOGLE_SERVICE_ACCOUNT_JSON: one-line JSON of a Play Console service account (View financial data)
GOOGLE_SERVICE_ACCOUNT_JSON=
ANDROID_PACKAGE=com.lyceum.app
VERIFY_BASE=
FACULTY_PER_HOUR=40
